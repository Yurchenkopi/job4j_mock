<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="6" author="PavelYurch">
        <insert tableName="template">
            <column name="type" value="REG"/>
            <column name="subject" value="Уведомление о регистрации"/>
            <column name="body" value="Здравствуйте, ${name}! &#10;Регистрация выполнена.&#10;Ключ доступа: ${key}"/>
        </insert>
        <insert tableName="template">
            <column name="type" value="FORGOT"/>
            <column name="subject" value="Восстановление пароля"/>
            <column name="body" value="Здравствуйте, ${name}! &#10;Новый пароль: ${password}"/>
        </insert>
    </changeSet>
</databaseChangeLog>